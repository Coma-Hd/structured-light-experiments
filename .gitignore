# Publish the runnable program and the selected experiment workspaces only.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/config.yaml
!/install.ps1
!/scripts/
!/src/
!/ceshi/
!/output/

/output/*
!/output/camera_intrinsic.yaml
!/output/laser_plane.yaml

/ceshi/*
!/ceshi/README.md
!/ceshi/曲面/
!/ceshi/rail/
!/ceshi/排错与优化文档/

/ceshi/rail/*
!/ceshi/rail/two_faces/

# Python environments and caches.
.venv/
__pycache__/
*.py[cod]

# Keep source, configuration, reports and point clouds; omit bulky captures.
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.npy
*.npz
*.7z
*.zip
*.rar
